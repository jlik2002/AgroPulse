# Скопируйте файл в .env и при необходимости поправьте значения:
#   cp .env.example .env

# local и test допускают пароли из этого файла. В dev и prod сервис
# откажется стартовать со значениями по умолчанию.
APP_ENV=local
LOG_LEVEL=INFO
# Однострочный JSON вместо текста — формат для сборщика логов в кластере.
LOG_JSON=false

# --- PostgreSQL с расширением PostGIS ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=agropulse
POSTGRES_USER=agropulse
POSTGRES_PASSWORD=agropulse

# --- Redis ---
# Брокер и кэш живут в разных логических базах: вытеснение ключей кэша
# не должно затрагивать очередь задач.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB_BROKER=0
REDIS_DB_CACHE=1

# --- MinIO (S3-совместимое хранилище артефактов) ---
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=agropulse
S3_SECRET_KEY=agropulse123
S3_BUCKET=agropulse
# Внешний адрес для ссылок из браузера. Пусто — сервис отдаёт presigned-ссылки.
S3_PUBLIC_BASE_URL=

# --- Google Earth Engine ---
# Положите JSON сервис-аккаунта в ./secrets/gee-service-account.json.
# Без него сервис поднимется, но сбор спутниковых данных выполнить не сможет:
# резервный STAC-источник существует, но в цепочку сознательно не включён.
GEE_SERVICE_ACCOUNT_FILE=/run/secrets/gee-service-account.json
GEE_PROJECT=

# --- Сервис ML-моделей (восстановление пропусков и прогноз) ---
ML_SERVICE_URL=http://ml-service:8000
# ВРЕМЕННО: пока сервис моделей не готов, разрешает заглушку с приближением
# по соседним точкам, чтобы разработка не простаивала. Подлежит удалению.
ML_USE_DEV_STUB=true

# --- LLM через OpenRouter ---
# Без ключа сервис работает, но текстовые пояснения не генерируются.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3.8-27b
LLM_ENABLED=true

# --- параметры анализа ---
HISTORY_SEASONS=4
FORECAST_HORIZON_DAYS=14

# --- пределы фоновых задач ---
# Жёсткий предел обязан быть больше мягкого: по мягкому задача успевает
# записать конечный статус ошибки, по жёсткому её снимают без предупреждения.
COLLECT_SOFT_TIME_LIMIT_SECONDS=900
COLLECT_TIME_LIMIT_SECONDS=1200
ANALYZE_SOFT_TIME_LIMIT_SECONDS=300
ANALYZE_TIME_LIMIT_SECONDS=420
# Повтор выполняется только для временных ошибок: сеть, внешний источник,
# недоступный сервис моделей.
TASK_MAX_RETRIES=3
